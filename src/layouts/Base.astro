---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import {
  formatNumber,
  htmlLang,
  localePath,
  otherLocale,
  t,
  type Locale,
  type MessageKey,
} from '../i18n';
import { currentSeason, loadStats } from '../lib/data';
import { spotFor } from '../world/spots';
import { FEEDBACK_URL, MICROSOFT_NOTICE, MICROSOFT_RULES_URL, PRELAUNCH } from '../lib/site';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path of this page without the locale prefix, used for the language switch. */
  path: string;
}

const { locale, title, description, path } = Astro.props;
const pageTitle = title ? `${title} · ${t(locale, 'site.name')}` : t(locale, 'site.name');
const other = otherLocale(locale);
const nav: [MessageKey, string][] = [
  ['nav.playlist', '/playlist/'],
  ['nav.tunes', '/tunes/'],
  ['nav.meta', '/meta/'],
  ['nav.tuners', '/tuners/'],
];
const current = Astro.url.pathname;
// The live Festival Playlist season tints the whole site (see styles/global.css).
const season = currentSeason()?.season;
const stats = loadStats();

// Page changes slide along the diagonal (track mode); normal mode turns them off in CSS.
const diagonal = {
  forwards: {
    old: { name: 'fp-out', duration: '0.32s', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'fp-in', duration: '0.42s', easing: 'ease-out', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'fp-out-back', duration: '0.32s', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'fp-in-back', duration: '0.42s', easing: 'ease-out', fillMode: 'both' },
  },
};
---

<!doctype html>
<html lang={htmlLang(locale)} data-season={season}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t(locale, 'site.tagline')} />
    {PRELAUNCH && <meta name="robots" content="noindex" />}
    {/* The .racing address is the official one; workers.dev copies point to it. */}
    <link rel="canonical" href={new URL(localePath(locale, path), Astro.site).href} />
    <link rel="alternate" hreflang="pt-BR" href={localePath('pt-br', path)} />
    <link rel="alternate" hreflang="en" href={localePath('en', path)} />
    {/* Track mode (animated world) or normal mode, before the first paint (ADR-0019). */}
    <script is:inline>
      (() => {
        const apply = () => {
          let mode = null;
          try {
            mode = localStorage.getItem('fp-mode');
          } catch {
            /* storage blocked: use the default */
          }
          if (mode !== 'track' && mode !== 'normal') {
            mode = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'normal' : 'track';
          }
          document.documentElement.dataset.mode = mode;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen" data-spot={spotFor(path)}>
    {/* The voxel world behind every page (track mode); kept alive between pages. */}
    <div id="world" transition:persist="world" aria-hidden="true"></div>
    {/* Fixed on top; turns translucent once the page scrolls (see the script below). */}
    <header
      class="site-header border-b border-border/70"
      data-site-header
      transition:animate="none"
    >
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 sm:py-4">
        <a href={localePath(locale, '/')} class="display text-2xl text-accent">
          {t(locale, 'site.name')}
        </a>
        {/* Phone: the sections get a row of their own, below the logo; wider: inline. */}
        <div class="order-last -mx-4 flex w-[calc(100%+2rem)] gap-6 overflow-x-auto border-t border-border/70 px-4 pt-3 sm:order-none sm:mx-0 sm:w-auto sm:border-0 sm:p-0">
          {nav.map(([key, href]) => {
            const target = localePath(locale, href);
            return (
              <a
                href={target}
                class:list={[
                  'eyebrow whitespace-nowrap text-sm hover:text-text',
                  current.startsWith(target) ? 'text-season' : 'text-muted',
                ]}
              >
                {t(locale, key)}
              </a>
            );
          })}
          {/* Phone: the mode button sits at the end of the sections row. */}
          <button
            type="button"
            data-mode-toggle
            class="mode-toggle eyebrow ml-auto shrink-0 text-sm sm:hidden"
            title={t(locale, 'mode.help')}
          >
            <span class="mode-when-track">{t(locale, 'mode.toNormalShort')}</span>
            <span class="mode-when-normal">{t(locale, 'mode.toTrackShort')}</span>
          </button>
        </div>
        <button
          type="button"
          data-mode-toggle
          class="mode-toggle eyebrow ml-auto hidden text-sm sm:inline-block"
          title={t(locale, 'mode.help')}
        >
          <span class="mode-when-track">
            <span class="hidden lg:inline">{t(locale, 'mode.toNormal')}</span>
            <span class="lg:hidden">{t(locale, 'mode.toNormalShort')}</span>
          </span>
          <span class="mode-when-normal">
            <span class="hidden lg:inline">{t(locale, 'mode.toTrack')}</span>
            <span class="lg:hidden">{t(locale, 'mode.toTrackShort')}</span>
          </span>
        </button>
        <a
          href={localePath(locale, '/apoie/')}
          class="eyebrow ml-auto text-sm text-accent hover:text-text sm:ml-0"
        >
          ♥ {t(locale, 'nav.donate')}
        </a>
        <a
          href={localePath(other, path)}
          hreflang={htmlLang(other)}
          class="eyebrow text-sm text-muted hover:text-text"
        >
          {t(locale, 'nav.language')}
        </a>
      </nav>
    </header>
    {PRELAUNCH && (
      <div class="border-b border-border/70 bg-surface">
        <p class="mx-auto max-w-6xl px-4 py-2 text-xs text-muted">
          {t(locale, 'prelaunch.notice')}{' '}
          <a href={FEEDBACK_URL} target="_blank" rel="noopener" class="text-accent underline">
            {t(locale, 'prelaunch.contact')}
          </a>
        </p>
      </div>
    )}
    <main class="site-main mx-auto max-w-6xl px-4 py-10" transition:animate={diagonal}>
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl border-t border-border/70 px-4 py-8 text-xs text-muted">
      <p>{t(locale, 'footer.disclaimer')}</p>
      <p class="mt-1">
        <a href="https://forza.fandom.com" target="_blank" rel="noopener" class="hover:text-text">
          {t(locale, 'footer.wiki')} {t(locale, 'footer.images')}
        </a>
      </p>
      <p class="mt-1">
        {MICROSOFT_NOTICE}{' '}
        <a
          href={MICROSOFT_RULES_URL}
          target="_blank"
          rel="noopener"
          class="underline hover:text-text"
        >
          {t(locale, 'footer.rules')}
        </a>
      </p>
      <p class="mt-2 flex flex-wrap gap-x-4">
        <span>
          {t(locale, 'home.footerStats', {
            cars: formatNumber(locale, stats.cars),
            tunes: formatNumber(locale, stats.tunes),
            tuners: formatNumber(locale, stats.tuners),
          })}
        </span>
        <a href={localePath(locale, '/status/')} class="hover:text-text">
          {t(locale, 'nav.status')}
        </a>
        <a href={localePath(locale, '/legal/')} class="hover:text-text">
          {t(locale, 'nav.legal')}
        </a>
        <a href={localePath(locale, '/apoie/')} class="hover:text-text">
          {t(locale, 'footer.support')}
        </a>
      </p>
    </footer>
    <script>
      import '../world/client';

      // Runs once per visit (the client router keeps the page alive between pages).
      // Copy share codes: any element with data-copy (cards, playlist suggestions).
      document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-copy]');
        if (!button?.dataset.copy) return;
        void navigator.clipboard.writeText(button.dataset.copy).then(() => {
          const original = button.textContent;
          button.textContent = button.dataset.copiedLabel ?? '✓';
          setTimeout(() => (button.textContent = original), 1500);
        });
      });

      // Fixed menu: translucent after scrolling; its height feeds the sticky filter bars.
      const onScroll = () =>
        document
          .querySelector('[data-site-header]')
          ?.toggleAttribute('data-scrolled', window.scrollY > 8);
      window.addEventListener('scroll', onScroll, { passive: true });
      let headerObserver: ResizeObserver | undefined;
      let countdown = 0;

      // Runs on every page (first load and each client-side navigation).
      document.addEventListener('astro:page-load', () => {
        onScroll();
        const header = document.querySelector<HTMLElement>('[data-site-header]');
        headerObserver?.disconnect();
        if (header) {
          headerObserver = new ResizeObserver(() =>
            document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`),
          );
          headerObserver.observe(header);
        }

        // "Ends in" countdowns (home and playlist; weekly reset on Thursdays).
        clearInterval(countdown);
        const tick = () => {
          for (const el of document.querySelectorAll<HTMLElement>('[data-ends-at]')) {
            const ms = Date.parse(el.dataset.endsAt ?? '') - Date.now();
            if (Number.isNaN(ms)) continue;
            if (ms <= 0) {
              el.textContent = el.dataset.ended ?? '';
              continue;
            }
            const d = Math.floor(ms / 86_400_000);
            const h = Math.floor((ms % 86_400_000) / 3_600_000);
            el.textContent = (el.dataset.label ?? '')
              .replace('{d}', String(d))
              .replace('{h}', String(h));
          }
        };
        tick();
        countdown = window.setInterval(tick, 60_000);
      });
    </script>
  </body>
</html>
