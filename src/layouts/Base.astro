---
import '../styles/global.css';
import {
  formatNumber,
  htmlLang,
  localePath,
  otherLocale,
  t,
  type Locale,
  type MessageKey,
} from '../i18n';
import { currentSeason, loadStats } from '../lib/data';
import {
  DONATE_URL,
  FEEDBACK_URL,
  MICROSOFT_NOTICE,
  MICROSOFT_RULES_URL,
  PRELAUNCH,
} from '../lib/site';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path of this page without the locale prefix, used for the language switch. */
  path: string;
}

const { locale, title, description, path } = Astro.props;
const pageTitle = title ? `${title} · ${t(locale, 'site.name')}` : t(locale, 'site.name');
const other = otherLocale(locale);
const nav: [MessageKey, string][] = [
  ['nav.playlist', '/playlist/'],
  ['nav.tunes', '/tunes/'],
  ['nav.meta', '/meta/'],
  ['nav.tuners', '/tuners/'],
];
const current = Astro.url.pathname;
// The live Festival Playlist season tints the whole site (see styles/global.css).
const season = currentSeason()?.season;
const stats = loadStats();
---

<!doctype html>
<html lang={htmlLang(locale)} data-season={season}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t(locale, 'site.tagline')} />
    {PRELAUNCH && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="pt-BR" href={localePath('pt-br', path)} />
    <link rel="alternate" hreflang="en" href={localePath('en', path)} />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-border/70">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 sm:py-4">
        <a href={localePath(locale, '/')} class="display text-2xl text-accent">
          {t(locale, 'site.name')}
        </a>
        {/* Phone: the sections get a row of their own, below the logo; wider: inline. */}
        <div class="order-last -mx-4 flex w-[calc(100%+2rem)] gap-6 overflow-x-auto border-t border-border/70 px-4 pt-3 sm:order-none sm:mx-0 sm:w-auto sm:border-0 sm:p-0">
          {nav.map(([key, href]) => {
            const target = localePath(locale, href);
            return (
              <a
                href={target}
                class:list={[
                  'eyebrow whitespace-nowrap text-sm hover:text-text',
                  current.startsWith(target) ? 'text-season' : 'text-muted',
                ]}
              >
                {t(locale, key)}
              </a>
            );
          })}
        </div>
        <a
          href={DONATE_URL ?? `${localePath(locale, '/')}#apoie`}
          class="eyebrow ml-auto text-sm text-accent hover:text-text"
          {...(DONATE_URL ? { target: '_blank', rel: 'noopener' } : {})}
        >
          ♥ {t(locale, 'nav.donate')}
        </a>
        <a
          href={localePath(other, path)}
          hreflang={htmlLang(other)}
          class="eyebrow text-sm text-muted hover:text-text"
        >
          {t(locale, 'nav.language')}
        </a>
      </nav>
    </header>
    {PRELAUNCH && (
      <div class="border-b border-border/70 bg-surface">
        <p class="mx-auto max-w-6xl px-4 py-2 text-xs text-muted">
          {t(locale, 'prelaunch.notice')}{' '}
          <a href={FEEDBACK_URL} target="_blank" rel="noopener" class="text-accent underline">
            {t(locale, 'prelaunch.contact')}
          </a>
        </p>
      </div>
    )}
    <main class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl border-t border-border/70 px-4 py-8 text-xs text-muted">
      <p>{t(locale, 'footer.disclaimer')}</p>
      <p class="mt-1">
        <a href="https://forza.fandom.com" target="_blank" rel="noopener" class="hover:text-text">
          {t(locale, 'footer.wiki')} {t(locale, 'footer.images')}
        </a>
      </p>
      <p class="mt-1">
        {MICROSOFT_NOTICE}{' '}
        <a
          href={MICROSOFT_RULES_URL}
          target="_blank"
          rel="noopener"
          class="underline hover:text-text"
        >
          {t(locale, 'footer.rules')}
        </a>
      </p>
      <p class="mt-2 flex flex-wrap gap-x-4">
        <span>
          {t(locale, 'home.footerStats', {
            cars: formatNumber(locale, stats.cars),
            tunes: formatNumber(locale, stats.tunes),
            tuners: formatNumber(locale, stats.tuners),
          })}
        </span>
        <a href={localePath(locale, '/status/')} class="hover:text-text">
          {t(locale, 'nav.status')}
        </a>
      </p>
    </footer>
    <script>
      // Copy share codes: any element with data-copy (cards, playlist suggestions).
      document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-copy]');
        if (!button?.dataset.copy) return;
        void navigator.clipboard.writeText(button.dataset.copy).then(() => {
          const original = button.textContent;
          button.textContent = button.dataset.copiedLabel ?? '✓';
          setTimeout(() => (button.textContent = original), 1500);
        });
      });
    </script>
  </body>
</html>
