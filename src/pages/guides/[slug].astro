---
import GuidePage from '../../components/GuidePage.astro';
import { loadGuides, type Guide } from '../../lib/guides';

export function getStaticPaths() {
  return loadGuides('pt-br').map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
---

<GuidePage locale="pt-br" guide={guide} />
