---
import { formatNumber, t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { isPreview, loadStats } from '../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const stats = loadStats();
const cards = [
  { value: formatNumber(locale, stats.cars), label: t(locale, 'home.stats.cars') },
  { value: formatNumber(locale, stats.tunes), label: t(locale, 'home.stats.tunes') },
  { value: formatNumber(locale, stats.coded), label: t(locale, 'home.stats.coded') },
  { value: formatNumber(locale, stats.tuners), label: t(locale, 'home.stats.tuners') },
  { value: `${stats.coverage}%`, label: t(locale, 'home.stats.coverage') },
];
---

<Base locale={locale} path="/">
  <p class="text-sm font-semibold uppercase tracking-wide text-accent">
    {t(locale, 'home.building')}
  </p>
  <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{t(locale, 'home.title')}</h1>
  <p class="mt-4 max-w-2xl text-muted">{t(locale, 'home.lead')}</p>

  <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    {cards.map((card) => (
      <li class="rounded-lg border border-border bg-surface p-4">
        <p class="text-2xl font-bold tabular-nums">{card.value}</p>
        <p class="mt-1 text-sm text-muted">{card.label}</p>
      </li>
    ))}
  </ul>

  <p class="mt-6 text-sm text-muted">
    {isPreview ? t(locale, 'home.preview') : t(locale, 'home.publicOnly')}
  </p>
</Base>
