---
import { formatNumber, localePath, t, type Locale, type MessageKey } from '../i18n';
import Base from '../layouts/Base.astro';
import {
  currentSeason,
  isPreview,
  loadEvents,
  loadRecentChanges,
  loadStats,
  maps,
} from '../lib/data';
import ClassBadge from './ClassBadge.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const stats = loadStats();
const cards = [
  { value: formatNumber(locale, stats.cars), label: t(locale, 'home.stats.cars') },
  { value: formatNumber(locale, stats.tunes), label: t(locale, 'home.stats.tunes') },
  { value: formatNumber(locale, stats.coded), label: t(locale, 'home.stats.coded') },
  { value: formatNumber(locale, stats.tuners), label: t(locale, 'home.stats.tuners') },
  { value: `${stats.coverage}%`, label: t(locale, 'home.stats.coverage') },
];
const season = currentSeason();
const highlights = season
  ? loadEvents(season.id).filter((e) =>
      ['championship', 'trial', 'weekly-challenge'].includes(e.category),
    )
  : [];
const changes = loadRecentChanges(12);
const { cars } = maps();
---

<Base locale={locale} path="/">
  <p class="text-sm font-semibold uppercase tracking-wide text-accent">
    {t(locale, 'home.building')}
  </p>
  <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{t(locale, 'home.title')}</h1>
  <p class="mt-4 max-w-2xl text-muted">{t(locale, 'home.lead')}</p>

  <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    {cards.map((card) => (
      <li class="rounded-lg border border-border bg-surface p-4">
        <p class="text-2xl font-bold tabular-nums">{card.value}</p>
        <p class="mt-1 text-sm text-muted">{card.label}</p>
      </li>
    ))}
  </ul>
  <p class="mt-4 text-sm text-muted">
    {isPreview ? t(locale, 'home.preview') : t(locale, 'home.publicOnly')}
  </p>

  <div class="mt-10 grid gap-8 lg:grid-cols-2">
    {season && (
      <section>
        <h2 class="text-xl font-semibold">{t(locale, 'home.live')}</h2>
        <p class="mt-1 text-sm text-muted">
          S{String(season.series).padStart(2, '0')} {season.seriesName} ·{' '}
          {t(locale, `season.${season.season}`)}
        </p>
        <ul class="mt-3 divide-y divide-border rounded-lg border border-border bg-surface text-sm">
          {highlights.map((e) => (
            <li class="flex flex-wrap items-center gap-2 px-4 py-2">
              <ClassBadge value={e.requirement.class} />
              <span class="font-medium">{e.name}</span>
              <span class="text-muted">
                {e.requirement.scopeLabel ?? t(locale, 'playlist.anyCar')}
              </span>
            </li>
          ))}
        </ul>
        <a
          href={localePath(locale, '/playlist/')}
          class="mt-3 inline-block text-sm font-semibold text-accent hover:underline"
        >
          {t(locale, 'common.viewAll')} →
        </a>
      </section>
    )}
    <section>
      <h2 class="text-xl font-semibold">{t(locale, 'home.changes')}</h2>
      {changes.length === 0 ? (
        <p class="mt-3 text-sm text-muted">{t(locale, 'home.noChanges')}</p>
      ) : (
        <ul class="mt-3 divide-y divide-border rounded-lg border border-border bg-surface text-sm">
          {changes.map((c) => (
            <li class="flex flex-wrap items-center gap-2 px-4 py-2">
              <span class="text-xs font-semibold uppercase text-accent">
                {t(locale, `change.${c.kind}` as MessageKey)}
              </span>
              <ClassBadge value={c.class} />
              <a href={localePath(locale, `/cars/${c.carId}/`)} class="hover:underline">
                {cars.get(c.carId)?.displayName ?? c.carId}
              </a>
              <span class="text-muted">{[c.before, c.after].filter(Boolean).join(' → ')}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Base>
