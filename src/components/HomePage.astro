---
import { htmlLang, localePath, t, type Locale } from '../i18n';
import { ClassChip } from '../islands/CarCard';
import Base from '../layouts/Base.astro';
import {
  currentSeason,
  isPreview,
  loadChanges,
  loadEvents,
  loadHighlights,
  loadList,
  loadSourceStatus,
  maps,
} from '../lib/data';
import { eventTypeLabel, formatReward, requirementText, seasonEndsAt } from '../lib/playlist';
import { TIER_LABELS } from '../lib/ui';
import EventIcon from './EventIcon.astro';
import SourceNews, { type NewsItem } from './SourceNews.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { tuners } = maps();
const today = new Date().toISOString().slice(0, 10);

// Updates of every reference source (owner: the site is an aggregator, and every source gets the
// same look and the same ordering rules). Every update counts, up or down (owner): last 14 days
// before the source's newest update; bigger changes first; one card per car × class × surface;
// no limit per source (the home page can be long).
// Changes are told in the source's own words (its tiers, labels and tune names), not ours.
const statuses = new Map(loadSourceStatus().map((st) => [st.id, st]));
/** Short names: the author, as the community calls each source. */
const SHORT: Record<string, string> = {
  'noa-miyako': 'Noa Miyako',
  fhstats: 'fhstats',
  logikj: 'LogikJ',
  'attax-johnson': 'Attax Johnson',
  kleis: 'kleis',
  'letzelu-shirakawa': 'LetzeLU',
  'k1z-gray': 'K1Z Gray',
};
const DAY = 86_400_000;
const daysBefore = (iso: string, n: number) =>
  new Date(Date.parse(iso) - n * DAY).toISOString().slice(0, 10);
const dateFmt = new Intl.DateTimeFormat(htmlLang(locale), {
  day: 'numeric',
  month: 'short',
  timeZone: 'UTC',
});
const fmt = (iso: string) => dateFmt.format(new Date(iso));
const tunerNames = (ids: readonly string[]) =>
  ids.map((id) => tuners.get(id)?.displayName ?? id).join(', ') || undefined;

/** Weight of a community-list label ("Meta+", "Strong"…), for the "bigger update first" rule. */
const labelPoints = (label: string | undefined) =>
  !label
    ? 1
    : /meta\s*\+|s\+/i.test(label)
      ? 5
      : /^meta|\bmeta\b/i.test(label)
        ? 4
        : /strong/i.test(label)
          ? 3
          : 2;

const news = new Map<string, NewsItem[]>();
const add = (id: string, n: NewsItem) => news.set(id, [...(news.get(id) ?? []), n]);

// Noa Miyako: the meta table's own update log and tier changes (highlights.json).
for (const h of loadHighlights()) {
  add(h.sourceId, {
    carId: h.carId,
    cls: h.class,
    surface: h.surface,
    date: h.date,
    kind: h.kind,
    magnitude: h.magnitude,
    before: h.previousTier
      ? { label: TIER_LABELS[h.previousTier], tier: h.previousTier }
      : undefined,
    after: { label: TIER_LABELS[h.tier], tier: h.tier },
    tuners: tunerNames(h.tunerIds),
  });
}

// Every other source: entries and tunes added or moved up, from the change log.
/**
 * More changes than this from one source in one sync are our own processing (a new source, a
 * tuner leaving, a name fix), not the author's update: left out.
 */
const BULK = 25;
const recent = loadChanges().filter(
  (c) => c.sourceId && c.sourceId !== 'noa-miyako' && c.at.slice(0, 10) >= daysBefore(today, 14),
);
const batch = (c: (typeof recent)[number]) => `${c.sourceId}|${c.at}|${c.entity.type}`;
const batchSize = new Map<string, number>();
for (const c of recent) batchSize.set(batch(c), (batchSize.get(batch(c)) ?? 0) + 1);
// A tune removed and added for the same car in the same window is a re-read, not news.
const reread = new Set<string>();
const seenKind = new Map<string, Set<string>>();
for (const c of recent) {
  const k = `${c.sourceId}|${c.entity.type}|${c.carId}|${c.class}|${c.surface}|${c.after ?? c.before ?? ''}`;
  seenKind.set(k, (seenKind.get(k) ?? new Set()).add(c.kind));
  if (seenKind.get(k)!.has('added') && seenKind.get(k)!.has('removed')) reread.add(k);
}
for (const c of recent) {
  if ((batchSize.get(batch(c)) ?? 0) > BULK) continue;
  const k = `${c.sourceId}|${c.entity.type}|${c.carId}|${c.class}|${c.surface}|${c.after ?? c.before ?? ''}`;
  if (reread.has(k)) continue;
  // Noa Miyako's tier moves and new entries come from highlights.json; only its removals here.
  if (c.entity.type === 'meta-ranking' && c.kind !== 'removed') continue;
  const isTune = c.entity.type === 'tune';
  const noaTier = (v: string | undefined) =>
    c.entity.type === 'meta-ranking' && v && v in TIER_LABELS
      ? { label: TIER_LABELS[v as keyof typeof TIER_LABELS], tier: v as keyof typeof TIER_LABELS }
      : v
        ? { label: v }
        : undefined;
  const removed = c.kind === 'removed';
  add(c.sourceId!, {
    carId: c.carId,
    cls: c.class,
    surface: c.surface,
    date: c.at.slice(0, 10),
    kind: isTune
      ? removed
        ? 'tune-removed'
        : 'tune-added'
      : removed
        ? 'list-removed'
        : c.kind === 'added'
          ? 'list-added'
          : c.kind,
    // Size of the change, up or down: a move of several levels beats a new tune.
    magnitude: isTune
      ? 1
      : c.kind === 'tier-up' || c.kind === 'tier-down'
        ? 3 +
          Math.abs(labelPoints(c.after) - labelPoints(c.before)) +
          labelPoints(c.after ?? c.before)
        : 2 + labelPoints(c.after ?? c.before),
    before: !isTune && c.before ? noaTier(c.before) : undefined,
    after: removed && !isTune ? undefined : noaTier(c.after ?? c.before),
  });
}
// Lists that date their own entries (fhstats): entries updated in the window.
for (const id of ['fhstats', 'logikj', 'attax-johnson']) {
  for (const e of loadList(id)) {
    if (!e.date || e.date < daysBefore(today, 14)) continue;
    add(id, {
      carId: e.carId,
      cls: e.class,
      surface: e.surface,
      date: e.date,
      kind: 'tune-update',
      magnitude: labelPoints(e.label),
      after: { label: e.label },
      tuners: tunerNames(e.tunerIds),
    });
  }
}

const blocks = [...news]
  .map(([id, list]) => {
    const newest = list.reduce((max, n) => (n.date > max ? n.date : max), '');
    const cutoff = daysBefore(newest, 14);
    const seen = new Set<string>();
    const slot = (n: NewsItem) => `${n.carId}|${n.cls}|${n.surface}`;
    // Per car × class × surface, the latest change is the current state (a car can go down and
    // back up in the same week) and gets a card; the earlier ones go to a short history list
    // (owner: they are interesting history). Cards: bigger changes first.
    const recentFirst = list
      .filter((n) => n.date >= cutoff)
      .sort((a, b) => b.date.localeCompare(a.date));
    const history: NewsItem[] = [];
    const latest = recentFirst.filter((n) => {
      if (seen.has(slot(n))) return (history.push(n), false);
      seen.add(slot(n));
      return true;
    });
    const items = latest
      .sort((a, b) => b.magnitude - a.magnitude || b.date.localeCompare(a.date))
      .map((n) => ({ ...n, date: fmt(n.date) }));
    return {
      id,
      status: statuses.get(id),
      items,
      history: history.map((n) => ({ ...n, date: fmt(n.date) })),
      newest,
    };
  })
  .filter((b) => b.status && b.status.public !== false && b.items.length > 0)
  .sort((a, b) => b.newest.localeCompare(a.newest) || a.id.localeCompare(b.id));

const season = currentSeason();
const tiles = season
  ? loadEvents(season.id)
      .filter((e) => ['championship', 'trial', 'weekly-challenge'].includes(e.category))
      .slice(0, 6)
  : [];
---

<Base locale={locale} path="/">
  {/* data-stop: boards laid along the route in track mode (src/world/route.ts). */}
  <section class="manifesto" data-stop="hero">
    <h1 class="display max-w-4xl text-4xl sm:text-6xl">{t(locale, 'home.title')}</h1>
    <p class="mt-4 max-w-2xl text-lg">{t(locale, 'home.lead')}</p>
    <a href={localePath(locale, '/tunes/')} class="btn-accent mt-6">
      {t(locale, 'home.cta')} →
    </a>
  </section>

  <section class="mt-16">
    {/* data-cap: in track mode, the fixed header above the tower (src/world/route.ts). */}
    <div data-cap="news">
      <h2 class="display text-4xl sm:text-5xl">{t(locale, 'home.listsTitle')}</h2>
      <p class="mt-2 max-w-2xl text-muted">{t(locale, 'home.listsLead')}</p>
    </div>

    {blocks.length === 0 ? (
      <p class="mt-8 text-muted" data-stop="head">
        {t(locale, 'home.noHighlights')}
      </p>
    ) : (
      blocks.map((b) => (
        <SourceNews
          locale={locale}
          id={b.id}
          title={SHORT[b.id] ?? b.status!.name}
          url={b.status!.url}
          checked={b.status!.lastChangedAt ? fmt(b.status!.lastChangedAt) : undefined}
          items={b.items}
          history={b.history}
        />
      ))
    )}
  </section>

  {season && (
    <section class="mt-16">
      <div class="flex flex-wrap items-end justify-between gap-3" data-cap="playlist">
        <div>
          <p class="eyebrow text-season">
            S{String(season.series).padStart(2, '0')} {season.seriesName} ·{' '}
            {t(locale, `season.${season.season}`)}
          </p>
          <h2 class="display mt-1 text-4xl sm:text-5xl">{t(locale, 'home.playlistTitle')}</h2>
        </div>
        <div class="text-right">
          <p
            class="display text-xl text-season"
            data-ends-at={seasonEndsAt(season.endsOn)}
            data-label={t(locale, 'playlist.endsIn', { d: '{d}', h: '{h}' })}
            data-ended={t(locale, 'playlist.ended')}
          />
          <a
            href={localePath(locale, '/playlist/')}
            class="eyebrow text-sm text-accent hover:underline"
          >
            {t(locale, 'common.viewAll')} →
          </a>
        </div>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-panel="playlist">
        {tiles.map((event) => (
          <a
            href={`${localePath(locale, '/playlist/')}#${event.id}`}
            data-stop="tile"
            class="card group relative block min-h-44 overflow-hidden p-5 hover:border-season"
          >
            <span
              class="display pointer-events-none absolute -bottom-4 -right-1 select-none text-[6rem] text-season opacity-[0.08]"
              aria-hidden="true"
            >
              {event.requirement.class ?? '★'}
            </span>
            <span class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full bg-season/15 text-season">
              <EventIcon category={event.category} class="h-4 w-4" />
            </span>
            <p class="eyebrow pr-10 text-season">{eventTypeLabel(locale, event.type)}</p>
            <p class="display mt-1 pr-8 text-2xl group-hover:text-accent">{event.name}</p>
            <p class="mt-3 flex flex-wrap items-center gap-2 text-sm">
              <ClassChip cls={event.requirement.class} />
              <span class="font-semibold">{requirementText(locale, event)}</span>
            </p>
            {event.reward && (
              <p class="mt-3 truncate text-xs text-muted">
                {t(locale, 'playlist.reward')}: {formatReward(locale, event.reward)}
              </p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  {isPreview && <p class="mt-12 text-xs text-muted">{t(locale, 'home.preview')}</p>}
</Base>
