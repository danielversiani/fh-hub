---
import { t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { loadSourceStatus } from '../lib/data';
import { LEGAL } from '../lib/legal';
import { FEEDBACK_URL } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = LEGAL[locale];
// Only sources on the site; authorised ones first.
const ORDER = ['granted', 'public', 'not-required'] as const;
const sources = loadSourceStatus()
  .filter((s): s is typeof s & { permission: (typeof ORDER)[number] } =>
    (ORDER as readonly string[]).includes(s.permission),
  )
  .sort(
    (a, b) =>
      ORDER.indexOf(a.permission) - ORDER.indexOf(b.permission) || a.name.localeCompare(b.name),
  );
const tone = { granted: 'text-ok', public: 'text-text', 'not-required': 'text-muted' } as const;
---

<Base locale={locale} path="/legal/" title={text.title}>
  <p class="eyebrow text-season">{t(locale, 'site.name')}</p>
  <h1 class="display mt-2 text-4xl sm:text-5xl">{text.title}</h1>
  <p class="mt-4 max-w-3xl text-muted">{text.lead}</p>
  <p class="mt-2 text-xs text-muted">
    {text.notAdvice} · {text.updated}
  </p>

  <div class="mt-8 grid max-w-3xl gap-8">
    {text.sections.map((section) => (
      <section id={section.id}>
        <h2 class="surface-divider">
          <span>{section.title}</span>
        </h2>
        {section.paragraphs.map((p) => (
          <p class="mt-3 leading-relaxed">{p}</p>
        ))}
      </section>
    ))}

    <section id="fontes">
      <h2 class="surface-divider">
        <span>{text.sourcesTitle}</span>
      </h2>
      <p class="mt-3 leading-relaxed">{text.sourcesLead}</p>
      <ul class="mt-4 flex flex-col gap-1">
        {sources.map((s) => (
          <li class="row flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5 text-sm">
            <a href={s.url} target="_blank" rel="noopener" class="font-semibold hover:text-accent">
              {s.name}
            </a>
            <span class:list={['ml-auto text-xs', tone[s.permission]]}>
              {text.status[s.permission]}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <p>
      <a href={FEEDBACK_URL} target="_blank" rel="noopener" class="btn-accent">
        {text.requestsCta}
      </a>
    </p>
  </div>
</Base>
