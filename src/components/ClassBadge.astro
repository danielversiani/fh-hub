---
import type { CarClass } from '../../pipeline/schema/enums';
import { CLASS_COLORS } from '../lib/ui';

interface Props {
  value: CarClass | null | undefined;
  pi?: number | undefined;
}

const { value, pi } = Astro.props;
---

{value && (
  <span
    class="inline-flex items-center gap-1 rounded-xs px-1.5 py-0.5 text-xs font-bold text-white tabular-nums"
    style={`background:${CLASS_COLORS[value]}`}
  >
    {value}
    {pi !== undefined && <span class="font-medium opacity-90">{pi}</span>}
  </span>
)}
