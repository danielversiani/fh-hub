---
import { localePath, t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import type { Guide } from '../lib/guides';

interface Props {
  locale: Locale;
  guide: Guide;
  /** An unpublished guide at its unlisted review address (/guides/draft/<guide>/). */
  draft?: boolean;
}

/** One guide (ADR-0024), with when it was checked in the game and its sources. */
const { locale, guide, draft = false } = Astro.props;
const html = await guide.html();
const date = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString(locale === 'en' ? 'en' : 'pt-BR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<Base
  locale={locale}
  path={draft ? `/guides/draft/${guide.slug}/` : `/guides/${guide.slug}/`}
  title={guide.title}
  description={guide.summary}
  noindex={draft}
>
  {draft && (
    <p class="mb-6 max-w-3xl border-l-4 border-l-warn bg-surface px-3 py-2 text-sm">
      {t(locale, 'guides.draft')}
    </p>
  )}
  <p class="label">
    <a href={localePath(locale, '/guides/')} class="hover:text-text">
      {t(locale, 'nav.guides')}
    </a>
  </p>
  <h1 class="display mt-2 text-4xl sm:text-5xl">{guide.title}</h1>
  <p class="mt-4 max-w-3xl text-muted">{guide.summary}</p>
  <p
    class:list={[
      'mt-3 inline-block border-l-4 bg-surface px-3 py-1.5 text-xs',
      guide.verifiedAt ? 'border-l-accent' : 'border-l-warn',
    ]}
  >
    {guide.verifiedAt
      ? t(locale, 'guides.verified', { date: date(guide.verifiedAt) })
      : t(locale, 'guides.unverified')}
  </p>

  {/* Every part has a short version; "more details" opens layers below it (owner, 2026-11-22). */}
  <div class="mt-8 flex max-w-3xl flex-wrap items-center gap-x-3 gap-y-2 text-sm" data-guide-tools>
    <button type="button" class="pill" data-expand="open">
      {t(locale, 'guides.expandAll')}
    </button>
    <button type="button" class="pill" data-expand="close">
      {t(locale, 'guides.collapseAll')}
    </button>
  </div>

  {/* A solid card: long text over the animated world is hard to read. */}
  <article class="guide-body card mt-3 max-w-3xl p-5 sm:p-8" set:html={html} />

  <section class="mt-10 max-w-3xl">
    <h2 class="surface-divider">
      <span>{t(locale, 'guides.sources')}</span>
    </h2>
    <ul class="mt-3 flex flex-col gap-1 text-sm">
      {guide.sources.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener" class="hover:text-accent">
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  /** Expand / collapse every detail layer; open the layers around a linked section. */
  function setupGuide() {
    const article = document.querySelector<HTMLElement>('.guide-body');
    if (!article) return;
    const all = () => [...article.querySelectorAll('details')];
    document.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((button) => {
      button.addEventListener('click', () => {
        const open = button.dataset.expand === 'open';
        all().forEach((d) => (d.open = open));
      });
    });
    const target = location.hash
      ? document.getElementById(decodeURIComponent(location.hash.slice(1)))
      : null;
    for (let el = target?.parentElement; el; el = el.parentElement) {
      if (el instanceof HTMLDetailsElement) el.open = true;
    }
    target?.scrollIntoView();
    article.querySelectorAll<HTMLElement>('[data-deck]').forEach(setupDeck);
  }

  /**
   * A card deck: the cards sit in a stack; "next" throws the top card aside and slips it to the
   * back (a shuffle), "previous" brings the last one back on top. Arrows, keys and swipes work.
   */
  function setupDeck(deck: HTMLElement) {
    const stage = deck.querySelector<HTMLElement>('.deck-stage');
    const cards = [...deck.querySelectorAll<HTMLElement>('.deck-card')];
    if (!stage || !cards.length) return;
    let order = cards.map((_, i) => i);
    let busy = false;
    const paint = () => {
      order.forEach((card, pos) => {
        const el = cards[card]!;
        el.dataset.pos = String(Math.min(pos, 3));
        el.setAttribute('aria-hidden', pos === 0 ? 'false' : 'true');
        el.inert = pos !== 0;
      });
      // The stage takes the tallest card's height, so the page does not jump between cards.
      stage.style.height = `${Math.max(...cards.map((c) => c.offsetHeight)) + 24}px`;
    };
    const go = (dir: 1 | -1) => {
      if (busy || cards.length < 2) return;
      busy = true;
      if (dir === 1) {
        const top = cards[order[0]!]!;
        top.classList.add('deck-out');
        window.setTimeout(() => {
          order = [...order.slice(1), order[0]!];
          top.classList.remove('deck-out');
          paint();
          busy = false;
        }, 320);
      } else {
        order = [order[order.length - 1]!, ...order.slice(0, -1)];
        const top = cards[order[0]!]!;
        top.classList.add('deck-in');
        paint();
        window.setTimeout(() => {
          top.classList.remove('deck-in');
          busy = false;
        }, 320);
      }
    };
    deck.querySelector('[data-deck-next]')?.addEventListener('click', () => go(1));
    deck.querySelector('[data-deck-prev]')?.addEventListener('click', () => go(-1));
    deck.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    });
    let startX: number | null = null;
    stage.addEventListener('pointerdown', (e) => (startX = e.clientX));
    stage.addEventListener('pointerup', (e) => {
      if (startX !== null && Math.abs(e.clientX - startX) > 40) go(e.clientX < startX ? 1 : -1);
      startX = null;
    });
    // Hidden decks (inside closed layers) measure 0: measure again whenever a layer opens.
    deck.closest('.guide-body')?.addEventListener('toggle', paint, true);
    window.addEventListener('resize', paint);
    paint();
  }
  document.addEventListener('astro:page-load', setupGuide);
</script>
