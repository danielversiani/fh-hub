---
import { formatNumber, localePath, t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { loadTuners } from '../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tuners = [...loadTuners()]
  .filter((tuner) => tuner.tuneCount > 0)
  .sort((a, b) => b.tuneCount - a.tuneCount || a.displayName.localeCompare(b.displayName));
---

<Base locale={locale} path="/tuners/" title={t(locale, 'tuners.title')}>
  <h1 class="text-3xl font-bold">{t(locale, 'tuners.title')}</h1>
  <p class="mt-3 max-w-2xl text-muted">{t(locale, 'tuners.lead')}</p>
  <ul class="mt-6 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
    {tuners.map((tuner) => (
      <li>
        <a
          href={localePath(locale, `/tuners/${tuner.id}/`)}
          class="flex items-center justify-between rounded-lg border border-border bg-surface px-4 py-2.5 hover:border-accent"
        >
          <span class="font-medium">{tuner.displayName}</span>
          <span class="text-sm text-muted tabular-nums">
            {t(locale, 'cars.tunesCount', { n: formatNumber(locale, tuner.tuneCount) })}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
