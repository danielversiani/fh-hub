---
import { t, type Locale } from '../i18n';
import { DONATE_LINKS } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- Donation call to action (owner's request): fan-made, no ads, any amount helps. -->
<section class="donate card relative overflow-hidden p-6 sm:p-8">
  <div class="relative max-w-2xl">
    <p class="eyebrow text-accent">{t(locale, 'donate.title')}</p>
    <p class="mt-3 text-base leading-relaxed sm:text-lg">{t(locale, 'donate.body')}</p>
    {DONATE_LINKS.length > 0 ? (
      <div class="mt-5 flex flex-wrap gap-3">
        {DONATE_LINKS.map((link, i) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener"
            class:list={['btn-accent', i > 0 && 'btn-secondary']}
          >
            {t(locale, link.label)}
          </a>
        ))}
      </div>
    ) : (
      <span class="btn-accent btn-disabled mt-5" aria-disabled="true">
        {t(locale, 'donate.soon')}
      </span>
    )}
  </div>
</section>
