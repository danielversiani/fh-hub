---
import { t, type Locale } from '../i18n';
import { DONATE_URL } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- Donation call to action (owner's request): fan-made, no ads, any amount helps. -->
<section class="donate card relative overflow-hidden p-6 sm:p-8">
  <div class="relative max-w-2xl">
    <p class="eyebrow text-accent">{t(locale, 'donate.title')}</p>
    <p class="mt-3 text-base leading-relaxed sm:text-lg">{t(locale, 'donate.body')}</p>
    {DONATE_URL ? (
      <a href={DONATE_URL} target="_blank" rel="noopener" class="btn-accent mt-5">
        {t(locale, 'donate.cta')} ♥
      </a>
    ) : (
      <span class="btn-accent btn-disabled mt-5" aria-disabled="true">
        {t(locale, 'donate.soon')}
      </span>
    )}
  </div>
</section>
