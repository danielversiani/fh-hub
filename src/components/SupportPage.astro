---
import { t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import DonateBox from './DonateBox.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale} path="/apoie/" title={t(locale, 'nav.donate')}>
  <div class="max-w-3xl">
    <DonateBox locale={locale} />
  </div>
</Base>
