---
import { t, type Locale } from '../i18n';
import TuneBrowser from '../islands/TuneBrowser';
import Base from '../layouts/Base.astro';
import { tuneBrowserLabels } from '../lib/labels';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale} path="/tunes/" title={t(locale, 'tunes.title')}>
  <p class="eyebrow text-season">{t(locale, 'tunes.eyebrow')}</p>
  <h1 class="display mt-2 text-4xl sm:text-5xl">{t(locale, 'tunes.title')}</h1>
  <p class="mt-3 max-w-2xl text-muted">{t(locale, 'tunes.lead')}</p>
  <div class="mt-8">
    <TuneBrowser
      client:load
      labels={tuneBrowserLabels(locale)}
      base={locale === 'en' ? '/en' : ''}
      dataUrl="/data/browse.json"
    />
  </div>
</Base>
