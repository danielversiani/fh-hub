---
import type { Tuner } from '../../pipeline/schema/entities';
import { localePath, t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { loadTuneIndex, maps } from '../lib/data';
import TuneCard from './TuneCard.astro';

interface Props {
  locale: Locale;
  tuner: Tuner;
}

const { locale, tuner } = Astro.props;
const { cars } = maps();
const tunes = loadTuneIndex()
  .filter((tune) => tune.tunerId === tuner.id)
  .sort(
    (a, b) =>
      (cars.get(a.carId)?.displayName ?? '').localeCompare(cars.get(b.carId)?.displayName ?? '') ||
      a.name.localeCompare(b.name),
  );
---

<Base locale={locale} path={`/tuners/${tuner.id}/`} title={tuner.displayName}>
  <p class="text-sm text-muted">
    <a href={localePath(locale, '/tuners/')} class="hover:underline">
      {t(locale, 'nav.tuners')}
    </a>
  </p>
  <h1 class="mt-1 text-3xl font-bold">{t(locale, 'tuner.tunes', { name: tuner.displayName })}</h1>
  <div class="mt-6 grid gap-3 md:grid-cols-2">
    {tunes.map((tune) => (
      <TuneCard locale={locale} tune={tune} showCar />
    ))}
  </div>
</Base>
