---
import type { Car } from '../../pipeline/schema/entities';
import { localePath, t, type Locale } from '../i18n';
import CarCard, { buildsFor, RarityChip } from '../islands/CarCard';
import Base from '../layouts/Base.astro';
import { buildBrowseData } from '../lib/browse';
import { carCardLabels } from '../lib/labels';

interface Props {
  locale: Locale;
  car: Car;
}

const { locale, car } = Astro.props;
const data = buildBrowseData();
const browseCar = data.cars.find((c) => c.id === car.id)!;
const builds = buildsFor(
  data.tunes.filter((tune) => tune.car === car.id),
  data.meta.filter((m) => m.car === car.id),
  {},
  data.laps.filter((l) => l.car === car.id),
);
---

<Base
  locale={locale}
  path={`/cars/${car.id}/`}
  title={car.displayName}
  description={`${car.displayName}: ${t(locale, 'site.tagline')}`}
>
  {/* The car's photo sits behind the name and fades into the page (owner's request). */}
  <section class:list={['car-hero', browseCar.image && 'car-hero-with-photo']}>
    {browseCar.image && (
      <img
        src={browseCar.image}
        alt=""
        class="car-hero-photo"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    )}
    <div class="relative">
      <p class="label">
        <a href={localePath(locale, '/tunes/')} class="hover:text-text">
          {t(locale, 'nav.tunes')}
        </a>
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
        <h1 class="display text-4xl sm:text-6xl">{car.model}</h1>
        <RarityChip
          rarity={car.rarity}
          label={car.rarity ? t(locale, `rarity.${car.rarity}`) : ''}
        />
      </div>
      <p class="mt-1 text-muted">
        {car.make} · {car.year}
      </p>
    </div>
  </section>

  <div class="mt-8">
    <CarCard
      car={{ ...browseCar, image: undefined }}
      builds={builds}
      labels={carCardLabels(locale)}
      base={locale === 'en' ? '/en' : ''}
    />
  </div>
</Base>
