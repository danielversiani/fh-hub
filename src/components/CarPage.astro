---
import type { Car } from '../../pipeline/schema/entities';
import { localePath, t, type Locale } from '../i18n';
import CarCard, { buildsFor, CarPhoto, RarityChip } from '../islands/CarCard';
import Base from '../layouts/Base.astro';
import { buildBrowseData } from '../lib/browse';
import { carCardLabels } from '../lib/labels';

interface Props {
  locale: Locale;
  car: Car;
}

const { locale, car } = Astro.props;
const data = buildBrowseData();
const browseCar = data.cars.find((c) => c.id === car.id)!;
const builds = buildsFor(
  data.tunes.filter((tune) => tune.car === car.id),
  data.meta.filter((m) => m.car === car.id),
  {},
  data.laps.filter((l) => l.car === car.id),
);
---

<Base
  locale={locale}
  path={`/cars/${car.id}/`}
  title={car.displayName}
  description={`${car.displayName}: ${t(locale, 'site.tagline')}`}
>
  <p class="label">
    <a href={localePath(locale, '/tunes/')} class="hover:text-text">
      {t(locale, 'nav.tunes')}
    </a>
  </p>
  <div class="mt-3 grid items-end gap-6 md:grid-cols-[1fr_minmax(0,26rem)]">
    <div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <h1 class="display text-4xl sm:text-5xl">{car.model}</h1>
        <RarityChip
          rarity={car.rarity}
          label={car.rarity ? t(locale, `rarity.${car.rarity}`) : ''}
        />
      </div>
      <p class="mt-1 text-muted">
        {car.make} · {car.year}
      </p>
    </div>
    <CarPhoto car={browseCar} class="car-photo-hero" />
  </div>

  <div class="mt-8">
    <CarCard
      car={{ ...browseCar, image: undefined }}
      builds={builds}
      labels={carCardLabels(locale)}
      base={locale === 'en' ? '/en' : ''}
    />
  </div>
</Base>
