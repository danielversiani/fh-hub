---
import type { Car } from '../../pipeline/schema/entities';
import { localePath, t, type Locale } from '../i18n';
import CarCard, { buildsFor, ClassChip, RarityChip } from '../islands/CarCard';
import Base from '../layouts/Base.astro';
import { buildBrowseData } from '../lib/browse';
import { loadLapTimes, loadMemeCars } from '../lib/data';
import { carCardLabels } from '../lib/labels';
import { formatLapTime } from '../lib/ui';

interface Props {
  locale: Locale;
  car: Car;
}

const { locale, car } = Astro.props;
const data = buildBrowseData(loadMemeCars());
const browseCar = data.cars.find((c) => c.id === car.id)!;
const builds = buildsFor(
  data.tunes.filter((tune) => tune.car === car.id),
  data.meta.filter((m) => m.car === car.id),
);
const laps = loadLapTimes().filter((l) => l.carId === car.id);
---

<Base
  locale={locale}
  path={`/cars/${car.id}/`}
  title={car.displayName}
  description={`${car.displayName}: ${t(locale, 'site.tagline')}`}
>
  <p class="eyebrow text-muted">
    <a href={localePath(locale, '/tunes/')} class="hover:text-text">
      {t(locale, 'nav.tunes')}
    </a>
  </p>
  <div class="mt-2 flex flex-wrap items-end gap-x-4 gap-y-2">
    <h1 class="display text-5xl sm:text-6xl">{car.model}</h1>
    <ClassChip cls={car.stock?.class} pi={car.stock?.pi} />
    <RarityChip rarity={car.rarity} label={car.rarity ? t(locale, `rarity.${car.rarity}`) : ''} />
  </div>
  <p class="mt-2 text-muted">
    {car.make} · {car.year}
  </p>

  <div class="mt-8">
    <CarCard car={browseCar} builds={builds} labels={carCardLabels(locale)} />
  </div>

  {laps.length > 0 && (
    <section class="mt-10">
      <h2 class="display text-3xl">{t(locale, 'car.laptimes')}</h2>
      <ul class="mt-3 space-y-1 text-sm">
        {laps.map((lap) => (
          <li class="flex flex-wrap items-center gap-2">
            <ClassChip cls={lap.class} />
            <span class="font-mono tabular-nums">{formatLapTime(lap.timeMs)}</span>
            <span>{lap.track}</span>
            <span class="text-muted">
              {lap.driver}
              {lap.tuneName && ` · ${lap.tuneName}`}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
