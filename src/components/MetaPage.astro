---
import type { MetaRanking } from '../../pipeline/schema/entities';
import type { Surface } from '../../pipeline/schema/enums';
import { localePath, t, type Locale, type MessageKey } from '../i18n';
import Base from '../layouts/Base.astro';
import { loadMeta, maps } from '../lib/data';
import { CLASS_ORDER } from '../lib/ui';
import ClassBadge from './ClassBadge.astro';
import TierBadge from './TierBadge.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { cars, tuners, sources } = maps();
const SURFACES: Surface[] = ['road', 'dirt', 'cross-country'];
const groups = new Map<string, MetaRanking[]>();
for (const m of loadMeta()) {
  const key = `${m.sourceId}|${m.class}|${m.surface}`;
  groups.set(key, [...(groups.get(key) ?? []), m]);
}
const sections = [...groups.entries()]
  .map(([key, rows]) => {
    const [sourceId = '', cls = '', surface = ''] = key.split('|');
    return { key, sourceId, cls, surface, rows: [...rows].sort((a, b) => a.rank - b.rank) };
  })
  .sort(
    (a, b) =>
      CLASS_ORDER.indexOf(b.cls as (typeof CLASS_ORDER)[number]) -
        CLASS_ORDER.indexOf(a.cls as (typeof CLASS_ORDER)[number]) ||
      SURFACES.indexOf(a.surface as Surface) - SURFACES.indexOf(b.surface as Surface),
  );
const anchor = (s: { cls: string; surface: string }) => `${s.cls.toLowerCase()}-${s.surface}`;
---

<Base locale={locale} path="/meta/" title={t(locale, 'meta.title')}>
  <h1 class="text-3xl font-bold">{t(locale, 'meta.title')}</h1>
  <p class="mt-3 max-w-2xl text-muted">{t(locale, 'meta.lead')}</p>

  {sections.length === 0 ? (
    <p class="mt-8 text-muted">{t(locale, 'meta.empty')}</p>
  ) : (
    <>
      <nav class="mt-6 flex flex-wrap gap-2 text-sm">
        {sections.map((s) => (
          <a
            href={`#${anchor(s)}`}
            class="flex items-center gap-1.5 rounded-md border border-border bg-surface px-2.5 py-1 hover:border-accent"
          >
            <ClassBadge value={s.cls as (typeof CLASS_ORDER)[number]} />
            {t(locale, `surface.${s.surface}` as MessageKey)}
          </a>
        ))}
      </nav>
      {sections.map((s) => (
        <section id={anchor(s)} class="mt-10 scroll-mt-4">
          <h2 class="flex items-center gap-2 text-xl font-semibold">
            <ClassBadge value={s.cls as (typeof CLASS_ORDER)[number]} />
            {t(locale, `surface.${s.surface}` as MessageKey)}
          </h2>
          <p class="mt-1 text-xs text-muted">
            <a
              href={sources.get(s.sourceId)?.url}
              target="_blank"
              rel="noopener"
              class="hover:underline"
            >
              {t(locale, 'meta.credit', { source: sources.get(s.sourceId)?.name ?? s.sourceId })}
            </a>
          </p>
          <div class="mt-3 overflow-x-auto rounded-lg border border-border bg-surface">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-border text-muted">
                <tr>
                  <th class="px-3 py-2 font-medium">{t(locale, 'meta.rank')}</th>
                  <th class="px-3 py-2 font-medium">{t(locale, 'meta.tier')}</th>
                  <th class="px-3 py-2 font-medium">{t(locale, 'meta.car')}</th>
                  <th class="px-3 py-2 font-medium">{t(locale, 'common.drivetrain')}</th>
                  <th class="px-3 py-2 font-medium">{t(locale, 'common.difficulty')}</th>
                  <th class="px-3 py-2 font-medium">{t(locale, 'common.profile')}</th>
                  <th class="px-3 py-2 font-medium">{t(locale, 'meta.tuners')}</th>
                </tr>
              </thead>
              <tbody>
                {s.rows.map((m) => (
                  <tr class="border-b border-border last:border-0">
                    <td class="px-3 py-2 text-muted tabular-nums">{m.rank}</td>
                    <td class="px-3 py-2">
                      <TierBadge value={m.tier} />
                    </td>
                    <td class="px-3 py-2">
                      <a href={localePath(locale, `/cars/${m.carId}/`)} class="hover:underline">
                        {cars.get(m.carId)?.displayName ?? m.carId}
                      </a>
                    </td>
                    <td class="px-3 py-2">{m.drivetrain ?? ''}</td>
                    <td class="px-3 py-2">
                      {m.difficulty ? t(locale, `difficulty.${m.difficulty}` as MessageKey) : ''}
                    </td>
                    <td class="px-3 py-2">
                      {m.role ? t(locale, `role.${m.role}` as MessageKey) : ''}
                    </td>
                    <td class="px-3 py-2 text-muted">
                      {m.tunerIds.map((id, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={localePath(locale, `/tuners/${id}/`)} class="hover:underline">
                            {tuners.get(id)?.displayName ?? id}
                          </a>
                        </>
                      ))}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </>
  )}
</Base>
